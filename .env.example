# ==============================================================================
# EarnOra Environment Variables Template
# Copy this file to .env.local and configure your environment credentials.
# In development mode, the platform runs safely with mock OTP and sandbox M-Pesa.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/earnora"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Authentication & Session Secret
AUTH_SECRET="your-32-character-random-auth-secret"
SESSION_SECRET="your-32-character-random-session-secret"
NEXT_PUBLIC_REQUIRE_SIGNUP_VERIFICATION="false" # Set "true" to require SMS/OTP on registration, "false" to sign in directly

# SMS / OTP Service (Africa's Talking / Twilio for Kenyan numbers)
SMS_OTP_API_KEY="your-sms-gateway-api-key"
SMS_OTP_USERNAME="your-sms-gateway-username"
SMS_SENDER_ID="EarnOra"

# Safaricom M-Pesa Daraja 2.0 API Configuration
DARAJA_ENV="sandbox" # Options: sandbox | production
DARAJA_CONSUMER_KEY="your_daraja_consumer_key"
DARAJA_CONSUMER_SECRET="your_daraja_consumer_secret"
DARAJA_SHORTCODE="600000" # Business B2C Shortcode
DARAJA_INITIATOR_NAME="testapi"
DARAJA_SECURITY_CREDENTIAL="your_encrypted_security_credential"
DARAJA_PASSKEY="your_lipa_na_mpesa_online_passkey"
DARAJA_CALLBACK_URL="https://your-domain.co.ke/api/daraja/callback"
DARAJA_TIMEOUT_URL="https://your-domain.co.ke/api/daraja/timeout"
DARAJA_STK_CALLBACK_URL="https://your-domain.co.ke/api/payments/webhooks/mpesa"
DARAJA_WEBHOOK_SECRET="your_daraja_webhook_verification_secret"

# Advertiser Portal & Campaign Wallet Feature Flag
NEXT_PUBLIC_ADS_ENABLED="true" # Set "false" to disable Advertiser Portal and Sponsored Campaigns

# Payment Gateways (Money-In for Advertiser Wallets - Default: sandbox)
PAYMENT_GATEWAY_ENV="sandbox" # Options: sandbox | production
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"
PAYSTACK_WEBHOOK_SECRET="whsec_your_paystack_webhook_secret"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-your_flutterwave_secret_key"
FLUTTERWAVE_WEBHOOK_HASH="your_flutterwave_webhook_secret_hash"

# AI Support Assistant (Server-Side Only — Never expose to client)
ANTHROPIC_API_KEY="sk-ant-api03-your_anthropic_api_key"
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

